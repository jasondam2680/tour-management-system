# Ví dụ biến môi trường — copy thành .env rồi điền giá trị thật (KHÔNG commit .env)
#
# ⚠️  CHỌN ĐÚNG 1 TRONG 2 MỤC DƯỚI ĐÂY, tùy nơi bạn chạy lệnh:
#
# --- CÁCH 1: Chạy trên máy HOST với Docker Compose (khuyên dùng) ---
# 1. cd tour-op-system && docker compose up -d postgres
# 2. Copy DATABASE_URL dưới đây vào apps/api/.env
#    LƯU Ý: port là 6432 (compose map 6432:5432), KHÔNG phải 5432!
#    Dùng 127.0.0.1 thay vì "localhost" (tránh bệnh localhost -> IPv6 ::1 bị chiếm port)
#    Password lấy trong docker-compose.yml -> POSTGRES_PASSWORD
DATABASE_URL="postgresql://tour_op_user:tour_op_pass_2024@localhost:5432/tour_op_db"
#
# --- CÁCH 2: Chạy TRONG devcontainer / Codespaces ---
# Chỉ dùng khi mở project bằng devcontainer (VS Code "Reopen in Container").
# Trong mạng nội bộ container, host "db" mới có nghĩa:
# DATABASE_URL="postgresql://dev:dev@db:5432/devdb"
#
# ❌ SAI: dùng URL của Cách 2 rồi chạy lệnh trên máy host -> lỗi P1001 "Can't reach database server at db:5432"

# JWT secret cho API
JWT_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien"

# Public API URL cho frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# pgAdmin (nếu chạy trong docker-compose)
PGADMIN_DEFAULT_EMAIL='admin@tourop.com'
PGADMIN_DEFAULT_PASSWORD='admin123'