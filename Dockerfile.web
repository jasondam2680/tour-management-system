FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
# The committed package-lock.json can lag behind package.json (e.g. missing xlsx).
# Prefer reproducible `npm ci`; fall back to `npm install` so the image still builds.
RUN npm ci || npm install

COPY apps/web apps/web
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build --workspace=web

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web ./apps/web

EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=web", "--", "--hostname", "0.0.0.0"]
