# Example environment variables for local development / Codespaces
# Copy to .env and fill values (DO NOT commit real secrets)

# Postgres (used by Prisma) — for devcontainer docker-compose use: postgres://dev:dev@db:5432/devdb
DATABASE_URL=postgres://dev:dev@localhost:5432/devdb

# JWT secret for API
JWT_SECRET=your_jwt_secret_here

# Public API URL used by frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: pgAdmin defaults if running pgAdmin in docker-compose
PGADMIN_DEFAULT_EMAIL=admin@tourop.com
PGADMIN_DEFAULT_PASSWORD=admin123
